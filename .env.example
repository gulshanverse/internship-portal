# Internship Portal staging/production environment template
# Never commit a real .env file or real credentials.

# DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/internship_portal?schema=public"

# APPLICATION
NODE_ENV="staging"
APP_URL="https://staging.your-domain.com"
PUBLIC_SITE_URL="https://staging.your-domain.com"
PORT="3000"
TRUST_PROXY="false"

# AUTHENTICATION
# Use a high-entropy random value, at least 32 bytes, in staging/production.
AUTH_SECRET="replace-with-a-long-random-secret"
SESSION_COOKIE_NAME="internship_session"
SESSION_TTL_DAYS="7"

# PRIVATE OBJECT STORAGE
# The bucket/container must be private; application code must mediate access.
STORAGE_ENDPOINT="https://storage.example.com"
STORAGE_BUCKET="internship-portal-private"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
OBJECT_STORAGE_SIGNING_KEY=""
SIGNED_URL_TTL_SECONDS="300"
MAX_UPLOAD_BYTES="10485760"

# TRANSACTIONAL EMAIL
EMAIL_PROVIDER="disabled"
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Internship Portal <noreply@example.com>"

# SECURITY / RATE LIMITING
RATE_LIMIT_STORE="memory"
RATE_LIMIT_WINDOW_SECONDS="60"
AUTH_RATE_LIMIT_MAX="30"

# MONITORING
LOG_LEVEL="info"
ERROR_MONITORING_DSN=""
